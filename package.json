{
  "name": "avideo-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "next": "^16.3.3",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "preview": "npm run build && npm run start",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply avideo-v2 --local --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute avideo-v2 --local --persist-to .wrangler/state --file=seed/dev.sql",
    "db:migrate:remote": "wrangler d1 migrations apply avideo-v2 --remote"
  }
}
